# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and anon key come from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Pooled connection string (Supavisor, port 6543) with pgbouncer=true for the app.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
# Direct connection string (port 5432) used for migrations and seeding.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# AI Model Provider (Groq — ultra-fast Llama / GPT-OSS inference)
# ---------------------------------------------------------------------------
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Protects /api/cron/* endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=""
# Monthly token budget guard for the chat agent.
MONTHLY_TOKEN_BUDGET="2000000"

# ---------------------------------------------------------------------------
# Reset Plan & Habit Tracker (set either to "false" to hide the section)
# ---------------------------------------------------------------------------
RESET_PLAN_ENABLED="true"
HABIT_TRACKER_ENABLED="true"

# ---------------------------------------------------------------------------
# Diary Mode (set DIARY_ENABLED to "false" to hide the section entirely)
# ---------------------------------------------------------------------------
DIARY_ENABLED="true"
# Optional: disable every diary AI call while leaving the diary usable.
DIARY_AI_ENABLED="true"
# Optional: a separate model for the quiet layer. Defaults to GROQ_MODEL.
# DIARY_MODEL="openai/gpt-oss-120b"
