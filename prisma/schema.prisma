// LifeOS Agent — Prisma schema (PostgreSQL / Supabase)
// Auth lives in Supabase; User.id mirrors auth.users.id.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String  @id
  email    String  @unique
  name     String?
  timezone String  @default("Asia/Kolkata")
  avatarUrl String?

  // Planning preferences
  wakeTime      String @default("07:00")
  sleepTime     String @default("23:00")
  dayStartHour  Int    @default(6)
  dayEndHour    Int    @default(23)
  minSleepHours Float  @default(7.5)
  maxFocusHours Int    @default(6)
  monthlyTokenBudget Int @default(2000000)

  onboardedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domains   Domain[]
  events    Event[]
  tasks     Task[]
  memories  Memory[]
  agentLogs AgentLog[]
  briefs        Brief[]
  notifications Notification[]

  @@map("users")
}

model Domain {
  id     String @id @default(cuid())
  userId String
  slug   String
  name   String
  accent String
  icon   String
  tagline String @default("")
  goals  Json   @default("[]")
  notes  String @default("")
  isProtected Boolean @default(false)
  isEnabled   Boolean @default(true)
  sortOrder   Int     @default(0)
  agentPrompt String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  events   Event[]
  tasks    Task[]
  memories Memory[]

  @@unique([userId, slug])
  @@index([userId])
  @@map("domains")
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  domainId    String
  title       String
  description String   @default("")
  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false)
  // planned | suggested | done | cancelled
  status      String   @default("planned")
  // manual | agent | auto | import
  source      String   @default("manual")
  priority    Int      @default(1)
  location    String   @default("")
  // "WEEKLY:MO,WE,FR" | "DAILY" | null — expanded by lib/calendar/recurrence
  recurrence  String?
  recurrenceUntil DateTime?
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain        Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId, start])
  @@index([userId, domainId, start])
  @@map("events")
}

model Task {
  id              String    @id @default(cuid())
  userId          String
  domainId        String
  title           String
  notes           String    @default("")
  dueDate         DateTime?
  estimateMinutes Int       @default(30)
  // todo | doing | done | slipped
  status          String    @default("todo")
  priority        Int       @default(1)
  linkedEventId   String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, domainId])
  @@map("tasks")
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  domainId  String
  note      String
  embedding Json     @default("[]")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([userId, domainId])
  @@map("memories")
}

model AgentLog {
  id          String   @id @default(cuid())
  userId      String
  message     String
  reply       String   @default("")
  intent      String   @default("")
  domainSlug  String?
  toolCalls   Json     @default("[]")
  // [{ type, entity, id, before, after }]
  inverse     Json     @default("[]")
  result      Json     @default("{}")
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  engine      String   @default("rules")
  undone      Boolean  @default(false)
  undoneAt    DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("agent_logs")
}

model Brief {
  id        String   @id @default(cuid())
  userId    String
  // morning | review | insight
  kind      String
  forDate   DateTime
  headline  String   @default("")
  content   Json     @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, forDate])
  @@index([userId, forDate])
  @@map("briefs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  eventId   String?
  // "before_30m" | "before_15m" | "after_15m" | "morning_brief" | "review" | "system"
  type      String
  title     String
  message   String
  // "unread" | "read" | "confirmed_achieved" | "confirmed_missed" | "dismissed"
  status    String   @default("unread")
  link      String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([userId, eventId, type])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("notifications")
}

